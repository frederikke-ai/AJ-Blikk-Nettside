{
  "name": "aj-blikk-nettside",
  "version": "0.1.0",
  "private": true,
  "description": "Nettsiden for AJ Blikk AS",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/tailwind.css -o ./src/css/output.css --minify",
    "build:eleventy": "eleventy",
    "build": "npm run build:css && npm run build:eleventy",
    "watch:css": "tailwindcss -i ./src/css/tailwind.css -o ./src/css/output.css --watch",
    "watch:eleventy": "eleventy --serve",
    "dev": "concurrently \"npm:watch:css\" \"npm:watch:eleventy\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@tailwindcss/forms": "^0.5.11",
    "concurrently": "^10.0.4",
    "tailwindcss": "^3.4.19"
  }
}
