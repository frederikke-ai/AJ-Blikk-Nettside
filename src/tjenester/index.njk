<section class="section section-py">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {% for service in services %}
    <a href="/tjenester/{{ service.slug }}/" class="block rounded-lg border border-gray-200 bg-white p-6 transition hover:border-accent hover:shadow-md">
      <h2 class="mb-2 font-semibold text-brand">{{ service.title }}</h2>
      <p class="text-sm text-gray-500">TODO: Kort beskrivelse av {{ service.title | lower }}.</p>
      <span class="mt-3 inline-block text-sm font-medium text-accent">Les mer →</span>
    </a>
    {% endfor %}
  </div>
</section>

