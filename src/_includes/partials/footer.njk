<footer class="mt-16 bg-accent text-white">
  <div class="section grid gap-10 py-12 md:grid-cols-4">
    <div>
      <div class="mb-4 flex items-center">
        <img src="/img/logo-aj-blikk.png" alt="{{ company.name }}" class="h-28 w-auto shrink-0">
      </div>
      <p class="text-sm text-white/70">Blikkenslager i Bærum, Asker og Oslo siden {{ company.founded }}.</p>
    </div>

    <div>
      <h2 class="mb-3 font-semibold">Blikkenslager</h2>
      <ul class="space-y-2 text-sm text-white/70">
        {% for service in blikkenslager %}
        <li><a href="/blikkenslager/{{ service.slug }}/" class="hover:text-accent-light">{{ service.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div>
      <h2 class="mb-3 font-semibold">Snekker</h2>
      <ul class="space-y-2 text-sm text-white/70">
        {% for service in snekker %}
        <li><a href="/snekker/{{ service.slug }}/" class="hover:text-accent-light">{{ service.title }}</a></li>
        {% endfor %}
      </ul>
      <h2 class="mb-3 mt-6 font-semibold">Snarveier</h2>
      <ul class="space-y-2 text-sm text-white/70">
        <li><a href="/om-oss/" class="hover:text-accent-light">Om oss</a></li>
        <li><a href="/prosjekter/" class="hover:text-accent-light">Prosjekter</a></li>
        <li><a href="/kontakt/" class="hover:text-accent-light">Kontakt oss</a></li>
        <li><a href="/gratis-befaring/" class="hover:text-accent-light">Gratis befaring</a></li>
      </ul>
    </div>

    <div>
      <h2 class="mb-3 font-semibold">Kontakt</h2>
      <ul class="space-y-2 text-sm text-white/70">
        <li>{{ company.address }}</li>
        <li><a href="tel:{{ company.phoneRaw }}" class="hover:text-accent-light">{{ company.phone }}</a></li>
        <li><a href="mailto:{{ company.email }}" class="hover:text-accent-light">{{ company.email }}</a></li>
        <li>Org.nr: {{ company.orgNr }}</li>
        <li>Åpningstider: {{ company.hours }}</li>
        <li>Arbeidsområde: {{ company.area }}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10 py-4 text-center text-xs text-white/60">
    © {{ currentYear }} {{ company.name }}. Alle rettigheter reservert.
  </div>
</footer>
