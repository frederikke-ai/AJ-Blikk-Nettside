<footer class="mt-16 border-t border-gray-200 bg-brand-light text-brand">
  <div class="section grid gap-10 py-12 md:grid-cols-4">
    <div>
      <div class="mb-4 flex items-center">
        <img src="/img/logo-aj-blikk.png" alt="{{ company.name }}" class="h-16 w-auto shrink-0">
      </div>
      <p class="text-sm text-gray-600">Blikkenslagertjenester i Oslo og Akershus siden {{ company.founded }}.</p>
    </div>

    <div>
      <h2 class="mb-3 font-semibold">Tjenester</h2>
      <ul class="space-y-2 text-sm text-gray-600">
        {% for service in services %}
        <li><a href="/tjenester/{{ service.slug }}/" class="hover:text-accent">{{ service.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div>
      <h2 class="mb-3 font-semibold">Snarveier</h2>
      <ul class="space-y-2 text-sm text-gray-600">
        <li><a href="/om-oss/" class="hover:text-accent">Om oss</a></li>
        <li><a href="/prosjekter/" class="hover:text-accent">Prosjekter</a></li>
        <li><a href="/kontakt/" class="hover:text-accent">Kontakt oss</a></li>
        <li><a href="/gratis-befaring/" class="hover:text-accent">Gratis befaring</a></li>
      </ul>
    </div>

    <div>
      <h2 class="mb-3 font-semibold">Kontakt</h2>
      <ul class="space-y-2 text-sm text-gray-600">
        <li>{{ company.address }}</li>
        <li><a href="tel:{{ company.phoneRaw }}" class="hover:text-accent">{{ company.phone }}</a></li>
        <li><a href="mailto:{{ company.email }}" class="hover:text-accent">{{ company.email }}</a></li>
        <li>Org.nr: {{ company.orgNr }}</li>
        <li>Åpningstider: {{ company.hours }}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-gray-200 py-4 text-center text-xs text-gray-500">
    © {{ currentYear }} {{ company.name }}. Alle rettigheter reservert.
  </div>
</footer>
