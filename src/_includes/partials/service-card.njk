{% macro card(service, basePath) %}
<a href="/{{ basePath }}/{{ service.slug }}/" class="group block overflow-hidden rounded-xl bg-brand-light ring-1 ring-black/5 transition hover:shadow-lg">
  <div class="relative aspect-[4/3] overflow-hidden bg-gray-200">
    {% if service.image %}
    <img src="{{ service.image }}" alt="{{ service.title }}" class="h-full w-full object-cover transition duration-300 group-hover:scale-105">
    {% else %}
    <div class="flex h-full w-full items-center justify-center px-4 text-center text-xs text-gray-400">TODO: Bilde av {{ service.title | lower }}</div>
    {% endif %}
    <span class="absolute left-4 top-4 h-2 w-9 rounded-full bg-accent"></span>
  </div>
  <div class="p-5">
    <h3 class="mb-2 font-semibold text-brand">{{ service.title }}</h3>
    <p class="text-sm text-gray-600">{{ service.intro | truncate(90) }}</p>
    <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-accent">
      Les mer
      <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
    </span>
  </div>
</a>
{% endmacro %}
