{% import "partials/service-card.njk" as serviceCard %}
{% macro section(items, basePath, seeAllUrl, seeAllText) %}
<div data-carousel class="relative">
  <div data-carousel-track class="carousel-track">
    {% for service in items %}
    <div class="carousel-item">
      {{ serviceCard.card(service, basePath) }}
    </div>
    {% endfor %}
  </div>
  <div class="mt-2 flex items-center justify-between">
    <a href="{{ seeAllUrl }}" class="font-semibold text-accent hover:underline">{{ seeAllText }} →</a>
    <div class="flex gap-2">
      <button type="button" data-carousel-prev aria-label="Forrige" class="carousel-btn">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <button type="button" data-carousel-next aria-label="Neste" class="carousel-btn">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>
</div>
{% endmacro %}
