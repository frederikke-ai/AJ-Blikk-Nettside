<header class="bg-brand text-white">
  <!-- Toppbar -->
  <div class="section flex items-center justify-between border-b border-white/10 py-2 text-sm">
    <div class="flex items-center gap-4">
      <a href="tel:{{ company.phoneRaw }}" class="hover:text-accent-light">{{ company.phone }}</a>
      <a href="mailto:{{ company.email }}" class="hidden hover:text-accent-light sm:inline">{{ company.email }}</a>
    </div>
    <div class="hidden sm:block">Åpningstider: {{ company.hours }}</div>
  </div>

  <!-- Checkbox-hack for mobilmeny (krever ingen JavaScript) -->
  <input type="checkbox" id="nav-toggle" class="peer hidden">

  <div class="section flex items-center justify-between py-4">
    <a href="/" class="flex items-center gap-3">
      <!-- TODO: Bytt ut med ekte logo-fil når den er levert -->
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md border border-white/30 bg-white/10 text-center text-[10px] leading-tight">LOGO</span>
      <span class="text-xl font-bold tracking-wide">{{ company.name }}</span>
    </a>

    <!-- Desktop-meny -->
    <nav class="hidden items-center gap-7 font-medium lg:flex" aria-label="Hovedmeny">
      <a href="/" class="hover:text-accent-light">Hjem</a>
      <a href="/om-oss/" class="hover:text-accent-light">Om oss</a>

      <div class="group relative">
        <a href="/tjenester/" class="flex items-center gap-1 hover:text-accent-light">
          Tjenester
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </a>
        <div class="invisible absolute left-0 top-full z-50 w-64 rounded-md bg-white py-2 text-brand opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100">
          {% for service in services %}
          <a href="/tjenester/{{ service.slug }}/" class="block px-4 py-2 hover:bg-gray-50 hover:text-accent">{{ service.title }}</a>
          {% endfor %}
        </div>
      </div>

      <div class="group relative">
        <a href="/prosjekter/" class="flex items-center gap-1 hover:text-accent-light">
          Prosjekter
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </a>
        <div class="invisible absolute left-0 top-full z-50 w-56 rounded-md bg-white py-2 text-brand opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100">
          {% for cat in projectCategories %}
          <a href="/prosjekter/{{ cat.slug }}/" class="block px-4 py-2 hover:bg-gray-50 hover:text-accent">{{ cat.title }}</a>
          {% endfor %}
        </div>
      </div>

      <a href="/kontakt/" class="hover:text-accent-light">Kontakt oss</a>
      <a href="/gratis-befaring/" class="btn-primary">Gratis befaring</a>
    </nav>

    <!-- Mobilmeny-knapp -->
    <label for="nav-toggle" class="cursor-pointer p-2 lg:hidden" aria-label="Åpne meny">
      <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
    </label>
  </div>

  <!-- Mobilmeny -->
  <nav class="hidden flex-col gap-1 bg-brand-dark px-4 pb-6 pt-2 font-medium peer-checked:flex lg:hidden" aria-label="Mobilmeny">
    <a href="/" class="rounded px-2 py-2 hover:bg-white/10">Hjem</a>
    <a href="/om-oss/" class="rounded px-2 py-2 hover:bg-white/10">Om oss</a>

    <details class="rounded px-2 py-2">
      <summary class="cursor-pointer">Tjenester</summary>
      <div class="ml-3 mt-2 flex flex-col gap-1 text-white/80">
        <a href="/tjenester/" class="py-1 hover:text-accent-light">Alle tjenester</a>
        {% for service in services %}
        <a href="/tjenester/{{ service.slug }}/" class="py-1 hover:text-accent-light">{{ service.title }}</a>
        {% endfor %}
      </div>
    </details>

    <details class="rounded px-2 py-2">
      <summary class="cursor-pointer">Prosjekter</summary>
      <div class="ml-3 mt-2 flex flex-col gap-1 text-white/80">
        <a href="/prosjekter/" class="py-1 hover:text-accent-light">Alle prosjekter</a>
        {% for cat in projectCategories %}
        <a href="/prosjekter/{{ cat.slug }}/" class="py-1 hover:text-accent-light">{{ cat.title }}</a>
        {% endfor %}
      </div>
    </details>

    <a href="/kontakt/" class="rounded px-2 py-2 hover:bg-white/10">Kontakt oss</a>
    <a href="/gratis-befaring/" class="btn-primary mt-2 text-center">Gratis befaring</a>
  </nav>
</header>
