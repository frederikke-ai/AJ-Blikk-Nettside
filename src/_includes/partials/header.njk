<header class="sticky top-0 z-50 bg-white shadow-sm">
  <!-- Toppbar -->
  <div class="section flex items-center justify-between border-b border-gray-100 bg-brand-light py-2 text-sm text-gray-600">
    <div class="flex items-center gap-4">
      <a href="tel:{{ company.phoneRaw }}" class="hover:text-accent">{{ company.phone }}</a>
      <a href="mailto:{{ company.email }}" class="hidden hover:text-accent sm:inline">{{ company.email }}</a>
    </div>
    <div class="hidden text-gray-500 sm:block">Åpningstider: {{ company.hours }}</div>
  </div>

  <!-- Checkbox-hack for mobilmeny (krever ingen JavaScript) -->
  <input type="checkbox" id="nav-toggle" class="peer hidden">

  <div class="section flex items-center justify-between border-b border-gray-100 py-3">
    <a href="/" class="flex items-center">
      <img src="/img/logo-aj-blikk.png" alt="{{ company.name }}" class="h-16 w-auto shrink-0 sm:h-20">
    </a>

    <!-- Desktop-meny -->
    <nav class="hidden items-center gap-7 font-medium text-gray-800 lg:flex" aria-label="Hovedmeny">
      <a href="/" class="hover:text-accent">Hjem</a>
      <a href="/om-oss/" class="hover:text-accent">Om oss</a>

      <div class="group relative">
        <a href="/tjenester/" class="flex items-center gap-1 hover:text-accent">
          Tjenester
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </a>
        <div class="invisible absolute left-0 top-full z-50 w-64 rounded-md border border-gray-100 bg-white py-2 text-brand opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100">
          {% for service in services %}
          <a href="/tjenester/{{ service.slug }}/" class="block px-4 py-2 hover:bg-brand-light hover:text-accent">{{ service.title }}</a>
          {% endfor %}
        </div>
      </div>

      <div class="group relative">
        <a href="/prosjekter/" class="flex items-center gap-1 hover:text-accent">
          Prosjekter
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </a>
        <div class="invisible absolute left-0 top-full z-50 w-56 rounded-md border border-gray-100 bg-white py-2 text-brand opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100">
          {% for cat in projectCategories %}
          <a href="/prosjekter/{{ cat.slug }}/" class="block px-4 py-2 hover:bg-brand-light hover:text-accent">{{ cat.title }}</a>
          {% endfor %}
        </div>
      </div>

      <a href="/kontakt/" class="hover:text-accent">Kontakt oss</a>
      <a href="/gratis-befaring/" class="btn-primary">Gratis befaring</a>
    </nav>

    <!-- Mobilmeny-knapp -->
    <label for="nav-toggle" class="cursor-pointer p-2 text-gray-900 lg:hidden" aria-label="Åpne meny">
      <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
    </label>
  </div>

  <!-- Mobilmeny -->
  <nav class="hidden flex-col gap-1 border-t border-gray-100 bg-white px-4 pb-6 pt-2 font-medium text-brand peer-checked:flex lg:hidden" aria-label="Mobilmeny">
    <a href="/" class="rounded px-2 py-2 hover:bg-brand-light">Hjem</a>
    <a href="/om-oss/" class="rounded px-2 py-2 hover:bg-brand-light">Om oss</a>

    <details class="rounded px-2 py-2">
      <summary class="cursor-pointer">Tjenester</summary>
      <div class="ml-3 mt-2 flex flex-col gap-1 text-gray-600">
        <a href="/tjenester/" class="py-1 hover:text-accent">Alle tjenester</a>
        {% for service in services %}
        <a href="/tjenester/{{ service.slug }}/" class="py-1 hover:text-accent">{{ service.title }}</a>
        {% endfor %}
      </div>
    </details>

    <details class="rounded px-2 py-2">
      <summary class="cursor-pointer">Prosjekter</summary>
      <div class="ml-3 mt-2 flex flex-col gap-1 text-gray-600">
        <a href="/prosjekter/" class="py-1 hover:text-accent">Alle prosjekter</a>
        {% for cat in projectCategories %}
        <a href="/prosjekter/{{ cat.slug }}/" class="py-1 hover:text-accent">{{ cat.title }}</a>
        {% endfor %}
      </div>
    </details>

    <a href="/kontakt/" class="rounded px-2 py-2 hover:bg-brand-light">Kontakt oss</a>
    <a href="/gratis-befaring/" class="btn-primary mt-2 text-center">Gratis befaring</a>
  </nav>
</header>
