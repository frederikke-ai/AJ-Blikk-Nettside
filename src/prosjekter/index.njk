<section class="border-b border-gray-200 bg-brand-light">
  <div class="section section-py">
    <h1 class="text-3xl font-bold text-brand md:text-4xl">Prosjekter</h1>
    <p class="mt-3 max-w-2xl text-gray-600"><!-- TODO --> TODO: Kort ingress som introduserer prosjektporteføljen til AJ Blikk AS.</p>
  </div>
</section>

<section class="section section-py">
  <div class="grid gap-8 md:grid-cols-3">
    {% for cat in projectCategories %}
    <a href="/prosjekter/{{ cat.slug }}/" class="block rounded-lg bg-brand-light p-8 text-center ring-1 ring-black/5 transition hover:shadow-md">
      <h2 class="mb-2 text-lg font-semibold text-brand">{{ cat.title }}</h2>
      <p class="text-sm text-gray-500">{{ cat.description }}</p>
    </a>
    {% endfor %}
  </div>
</section>

