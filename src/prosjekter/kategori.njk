---
layout: layouts/base.njk
pagination:
  data: projectCategories
  size: 1
  alias: category
permalink: "/prosjekter/{{ category.slug }}/"
eleventyComputed:
  title: "Prosjekter – {{ category.title }}"
  description: "TODO: Skriv meta-beskrivelse for prosjektkategorien {{ category.title }}."
---
<section class="bg-brand text-white">
  <div class="section section-py">
    <p class="mb-2 text-sm text-white/60"><a href="/prosjekter/" class="hover:text-accent-light">Prosjekter</a> / {{ category.title }}</p>
    <h1 class="text-3xl font-bold md:text-4xl">Prosjekter – {{ category.title }}</h1>
    <p class="mt-3 max-w-2xl text-white/80">{{ category.description }}</p>
  </div>
</section>

<section class="section section-py">
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {% for i in range(0, 3) %}
    <div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
      <div class="flex aspect-video items-center justify-center bg-gray-100 text-sm text-gray-400">
        TODO: Bilde av prosjekt
      </div>
      <div class="p-5">
        <h2 class="mb-1 font-semibold text-brand">TODO: Prosjekttittel</h2>
        <p class="text-sm text-gray-500">TODO: Kort beskrivelse av prosjektet (sted, omfang, tjeneste utført).</p>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

{% include "partials/cta-banner.njk" %}
