---
layout: layouts/base.njk
title: Kontakt oss
description: "Kontakt AJ Blikk AS, blikkenslager i Oslo, Bærum og Asker."
---
<section class="border-b border-gray-200 bg-brand-light">
  <div class="section section-py">
    <h1 class="text-3xl font-bold text-brand md:text-4xl">Kontakt oss</h1>
    <p class="mt-3 max-w-2xl text-gray-600">Ta kontakt for spørsmål eller book en gratis befaring. Vi svarer så raskt vi kan.</p>
  </div>
</section>

<section class="section section-py grid gap-12 lg:grid-cols-2">
  <div class="space-y-6">
    <div>
      <h2 class="mb-1 font-semibold text-brand">Adresse</h2>
      <p class="text-gray-600">{{ company.address }}</p>
    </div>
    <div>
      <h2 class="mb-1 font-semibold text-brand">Telefon</h2>
      <p class="text-gray-600"><a href="tel:{{ company.phoneRaw }}" class="hover:text-accent">{{ company.phone }}</a></p>
    </div>
    <div>
      <h2 class="mb-1 font-semibold text-brand">E-post</h2>
      <p class="text-gray-600"><a href="mailto:{{ company.email }}" class="hover:text-accent">{{ company.email }}</a></p>
    </div>
    <div>
      <h2 class="mb-1 font-semibold text-brand">Åpningstider</h2>
      <p class="text-gray-600">{{ company.hours }}</p>
    </div>
    <div>
      <h2 class="mb-1 font-semibold text-brand">Arbeidsområde</h2>
      <p class="text-gray-600">{{ company.area }}</p>
    </div>
    <a href="/gratis-befaring/" class="btn-primary inline-block !text-white">Bestill gratis befaring</a>
  </div>

  <div class="min-h-[300px] overflow-hidden rounded-lg border border-gray-200 lg:h-full">
    <iframe
      src="https://www.google.com/maps?q={{ company.address | urlencode }}&output=embed"
      class="h-full min-h-[300px] w-full"
      style="border:0"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Kart til {{ company.name }}, {{ company.address }}"
    ></iframe>
  </div>
</section>
