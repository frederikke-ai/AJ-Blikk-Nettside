---
layout: layouts/base.njk
title: Hjem
description: "AJ Blikk AS er blikkenslager i Bærum, Asker og Oslo. Taktekking, takrenner, pipebeslag, taksikring og snekkertjenester. Gratis befaring."
---
{% import "partials/service-carousel.njk" as serviceCarousel %}
<section class="relative flex min-h-[520px] items-center overflow-hidden bg-brand md:min-h-[620px]">
  <img src="/img/hero.jpg" alt="" class="absolute inset-0 h-full w-full object-cover">
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/10"></div>

  <div class="section relative py-16 text-white">
    <p class="mb-4 inline-block rounded-md bg-white px-3 py-1.5 text-sm font-bold uppercase tracking-wide text-brand shadow-sm sm:text-base">Blikkenslager i Bærum, Asker og Oslo</p>
    <h1 class="mb-5 max-w-2xl text-3xl font-bold leading-tight md:text-5xl">
      Solid håndverk siden 1995
    </h1>
    <p class="mb-8 max-w-xl text-white/85">
      AJ Blikk er et solid blikkenslagerfirma med god forankring i Bærum. Vi utfører taktekking, takrenner, pipebeslag og taksikring, samt noe snekkerarbeid som terrasse og kjøkkenmontering, alltid til avtalt tid og pris. Vi tar oppdrag for privatpersoner, næringsbygg og borettslag/sameier i hele Bærum, Asker og Oslo.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/gratis-befaring/" class="btn-primary">Gratis befaring</a>
      <a href="/blikkenslager/" class="inline-block rounded-md border-2 border-white px-6 py-3 font-semibold text-white transition-colors hover:bg-white hover:text-brand">Se våre tjenester</a>
    </div>
  </div>
</section>

<section class="section section-py">
  <div class="mb-8 max-w-2xl">
    <h2 class="mb-3 text-2xl font-bold uppercase tracking-wide text-brand md:text-3xl">Blikkenslager</h2>
    <span class="mb-4 block h-1 w-14 rounded-full bg-accent"></span>
    <p class="text-gray-600">Som blikkenslager i Bærum, Asker og Oslo leverer vi taktekking, takrenner, pipebeslag, taksikring og mer.</p>
  </div>
  {{ serviceCarousel.section(blikkenslager, "blikkenslager", "/blikkenslager/", "Se alle blikkenslagertjenester") }}
</section>

<section class="bg-brand-light">
  <div class="section section-py">
    <div class="mb-8 max-w-2xl">
      <h2 class="mb-3 text-2xl font-bold uppercase tracking-wide text-brand md:text-3xl">Snekker</h2>
      <span class="mb-4 block h-1 w-14 rounded-full bg-accent"></span>
      <p class="text-gray-600">Vi kombinerer blikkenslagerfaget med snekkerarbeid, fra terrasse og rekkverk til panel og kjøkkenmontering.</p>
    </div>
    {{ serviceCarousel.section(snekker, "snekker", "/snekker/", "Se alle snekkertjenester", "from-brand-light") }}
  </div>
</section>

<section class="section section-py">
  <div class="mx-auto mb-10 max-w-2xl text-center">
    <h2 class="mb-3 text-2xl font-bold uppercase tracking-wide text-brand md:text-3xl">Prosjekter</h2>
    <span class="mx-auto mb-4 block h-1 w-14 rounded-full bg-accent"></span>
    <p class="text-gray-600">Et utvalg av prosjekter vi har levert i Bærum, Asker og Stor-Oslo.</p>
  </div>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {% for project in projects %}
    <div class="overflow-hidden rounded-lg bg-brand-light ring-1 ring-black/5">
      <div class="flex aspect-[4/3] items-center justify-center bg-gray-200 text-xs text-gray-400">
        TODO: Bilde
      </div>
      <div class="p-4">
        <h3 class="mb-1 font-semibold text-brand">{{ project.title }}</h3>
        <p class="text-sm text-gray-600">{{ project.description }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="mt-8 text-center">
    <a href="/prosjekter/" class="font-semibold text-accent hover:underline">Se alle prosjekter →</a>
  </div>
</section>

<section class="bg-brand-light">
  <div class="section section-py grid items-center gap-10 md:grid-cols-2">
    <div class="order-2 flex aspect-video items-center justify-center rounded-lg border border-gray-200 bg-white text-sm text-gray-400 md:order-1">
      TODO: Bilde av Anders og Jørgen / verksted
    </div>
    <div class="order-1 md:order-2">
      <h2 class="mb-4 text-2xl font-bold text-brand md:text-3xl">Håndverk i andre generasjon</h2>
      <blockquote class="mb-6 border-l-4 border-accent pl-6 text-lg italic text-brand">
        «Vi tar med oss arven etter fem tiår i bransjen inn i moderne løsninger og prosjekter, med samme standard for håndverk og kundebehandling som har kjennetegnet selskapet fra starten.»
        <footer class="mt-2 text-sm not-italic text-gray-500">Anders Haider</footer>
      </blockquote>
      <a href="/om-oss/" class="font-semibold text-brand hover:text-accent">Les mer om oss →</a>
    </div>
  </div>
</section>

{% include "partials/cta-banner.njk" %}
